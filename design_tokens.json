    "elevation": {
      "soft": {
        "shadowColor": "rgba(74, 13, 21, 0.04)",
        "shadowOffset": { "width": 0, "height": 4 },
        "shadowOpacity": 1,
        "shadowRadius": 12,
        "elevation": 2
      },
      "medium": {
        "shadowColor": "rgba(74, 13, 21, 0.06)",
        "shadowOffset": { "width": 0, "height": 8 },
        "shadowOpacity": 1,
        "shadowRadius": 20,
        "elevation": 4
      },
      "floating": {
        "shadowColor": "rgba(74, 13, 21, 0.08)",
        "shadowOffset": { "width": 0, "height": 16 },
        "shadowOpacity": 1,
        "shadowRadius": 32,
        "elevation": 8
      },
      "modal": {
        "shadowColor": "rgba(0, 0, 0, 0.15)",
        "shadowOffset": { "width": 0, "height": 24 },
        "shadowOpacity": 1,
        "shadowRadius": 48,
        "elevation": 16
      },
      "premium_glass": {
        "shadowColor": "rgba(74, 13, 21, 0.03)",
        "shadowOffset": { "width": 0, "height": 8 },
        "shadowOpacity": 1,
        "shadowRadius": 24,
        "backdropFilter": "blur(20px)"
      }
