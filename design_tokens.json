    "borderRadius": {
      "none": 0,
      "badge": 4,
      "input": 12,
      "button": 14,
      "avatar": 9999,
      "card_small": 16,
      "card_medium": 24,
      "card_large": 32,
      "bottom_sheet": 40,
      "dialog": 28,
      "floating_card": 20
