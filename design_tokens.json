    "typography": {
      "families": {
        "headings": "Cormorant Garamond",
        "body": "Plus Jakarta Sans"
      },
      "sizes": {
        "display": {
          "fontSize": 48,
          "lineHeight": 56,
          "fontWeight": "600",
          "letterSpacing": -1.5
        },
        "hero": {
          "fontSize": 36,
          "lineHeight": 44,
          "fontWeight": "600",
          "letterSpacing": -1.0
        },
        "h1": {
          "fontSize": 28,
          "lineHeight": 36,
          "fontWeight": "600",
          "letterSpacing": -0.5
