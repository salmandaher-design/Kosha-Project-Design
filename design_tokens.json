        "h2": {
          "fontSize": 22,
          "lineHeight": 28,
          "fontWeight": "600",
          "letterSpacing": -0.2
        },
        "h3": {
          "fontSize": 18,
          "lineHeight": 24,
          "fontWeight": "600",
          "letterSpacing": 0
        },
        "title": {
          "fontSize": 16,
          "lineHeight": 22,
          "fontWeight": "600",
          "letterSpacing": 0
        },
        "subtitle": {
          "fontSize": 14,
          "lineHeight": 20,
          "fontWeight": "500",
          "letterSpacing": 0
        },
        "body": {
          "fontSize": 15,
          "lineHeight": 22,
          "fontWeight": "400",
          "letterSpacing": 0
        },
        "caption": {
          "fontSize": 12,
          "lineHeight": 16,
          "fontWeight": "400",
          "letterSpacing": 0.2
        },
        "micro": {
          "fontSize": 10,
          "lineHeight": 12,
          "fontWeight": "500",
          "letterSpacing": 0.5
        },
        "button": {
          "fontSize": 14,
          "lineHeight": 20,
          "fontWeight": "600",
          "letterSpacing": 0.5
        },
        "navigation": {
          "fontSize": 11,
          "lineHeight": 14,
          "fontWeight": "500",
          "letterSpacing": 0.2
        }
      }
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "xxl": 24,
      "xxxl": 32,
      "huge": 40,
      "xhuge": 48,
      "layout_sm": 64,
      "layout_md": 80,
      "layout_lg": 96
